#compdef unrealmate
# Generated from unrealmate/registry/command_registry.toml
# Do not edit manually; run: python scripts/sync_completion_from_registry.py

_unrealmate() {
    local -a commands
    local -a asset_commands
    local -a build_commands
    local -a config_commands
    local -a git_commands
    local -a performance_commands
    local -a plugin_commands
    local -a report_commands

    commands=(
        'asset:Asset management commands'
        'build:Build and CI/CD tools'
        'config:Configuration management'
        'git:Git helper commands'
        'performance:Performance analysis commands'
        'plugin:Plugin management'
        'report:Reporting commands'
        'analytics:Show usage analytics and metrics. (local-only)'
        'doctor:Run interactive health checks for the project.'
        'version:Show system and version information.'
    )

    asset_commands=(
        'duplicates:Find and report duplicate assets by name or content hash.'
        'organize:Organize assets into proper directory structure based on file types.'
        'scan:Scan directory for Unreal Engine assets and provide a detailed report.'
    )

    build_commands=(
        'ci-init:Generate CI/CD pipeline configuration.'
        'docker:Generate optimized Dockerfile for Unreal Engine.'
        'info:Show build information and recommendations.'
    )

    config_commands=(
        'edit:Opens .unrealmate.toml in the system default editor.'
        'get:Get a configuration value.'
        'init:Initialize .unrealmate.toml configuration file.'
        'set:Set a configuration value.'
        'show:Show current configuration.'
        'template:Apply a performance preset template to .unrealmate.toml.'
        'validate:Validates .unrealmate.toml structure and values.'
    )

    git_commands=(
        'clean:Clean build artifacts, intermediate files, and temporary data.'
        'init:Initialize git configuration with optimized settings for Unreal Engine.'
        'lfs:Setup Git LFS used for large binary files (assets, maps, etc).'
    )

    performance_commands=(
        'memory:Audit memory usage and identify optimization opportunities.'
        'profile:Analyze performance metrics and detect bottlenecks.'
        'shaders:Analyze shader complexity and optimization opportunities.'
    )

    plugin_commands=(
        'disable:Disable a plugin in .uproject file.'
        'enable:Enable a plugin in .uproject file.'
        'install:Install a plugin from Git or local directory.'
        'list:List all installed plugins.'
        'remove:Remove a plugin from project.'
    )

    report_commands=(
        'html:Generate HTML project report with real stats.'
        'json:Export project stats as JSON (prints or saves to file).'
        'notify:Save a team notification to the project notification log. (local-only)'
    )

    _arguments -C \
        '1: :->command' \
        '2: :->subcommand' \
        '*: :->args'

    case $state in
        command)
            _describe 'command' commands
            ;;
        subcommand)
            case $words[2] in
                asset)
                    _describe 'asset subcommand' asset_commands
                    ;;
                build)
                    _describe 'build subcommand' build_commands
                    ;;
                config)
                    _describe 'config subcommand' config_commands
                    ;;
                git)
                    _describe 'git subcommand' git_commands
                    ;;
                performance)
                    _describe 'performance subcommand' performance_commands
                    ;;
                plugin)
                    _describe 'plugin subcommand' plugin_commands
                    ;;
                report)
                    _describe 'report subcommand' report_commands
                    ;;
            esac
            ;;
        args)
            _files
            ;;
    esac
}

_unrealmate "$@"
